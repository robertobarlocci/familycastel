{
    "name": "familycastel/familycastel",
    "description": "Family Castel — self-hosted family reward game for shared hosting (dev tooling only; the release ZIP has zero Composer runtime dependencies)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "FamilyCastel\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "FamilyCastel\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
